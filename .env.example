UID=1000
GID=1000

# Optional custom app name. Leave blank to use the default locale-specific name.
APP_NAME=

# SMTP configuration for email notifications
# Set SMTP_SENDER to a real sender email to enable emailing. If left empty
# or set to 'sender@example.com' the emailing system will remain disabled.
SMTP_SENDER=sender@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
# Google App Passwords are 16 chars (no spaces). Remove any grouping spaces and don't include surrounding quotes.
SMTP_PASSWORD=
